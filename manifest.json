  "nodes": [
    {
      "id": "omnivoice",
      "label": "OmniVoice 목소리",
      "description": "읽을 글을 이으면 목소리 WAV(24kHz)를 낸다. 참조 목소리(3~10초 말소리)를 이으면 그 목소리로 읽고, 참조 글에는 그 소리에서 말한 글을 잇는다. 참조가 없으면 고른 속성으로 목소리를 만들고, 속성도 고르지 않으면 모델이 목소리를 고른다. 글 안에 [laughter] · [sigh] 같은 표시를 넣으면 웃음 · 한숨을 낸다.",
      "inputs": [
        {
          "id": "text",
          "type": "text",
          "label": "읽을 글",
          "required": true
        },
        {
          "id": "ref-audio",
          "type": "audio",
          "label": "참조 목소리 (3~10초)",
          "required": false
        },
        {
          "id": "ref-text",
          "type": "text",
          "label": "참조 글 (참조 소리의 대사)",
          "required": false
        }
      ],
      "outputs": [
        {
          "id": "audio",
          "type": "audio",
          "label": "목소리"
        }
      ],
      "settings": [
        {
          "id": "language",
          "label": "언어",
          "help": "읽을 글의 언어. 자동은 모델이 글을 보고 정한다. 알려 주면 조금 더 정확하다.",
          "type": "select",
          "options": [
            {
              "value": "auto",
              "label": "자동"
            },
            {
              "value": "ko",
              "label": "한국어"
            },
